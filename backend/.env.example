# ProjectPulse AI - Backend Environment Configuration

PROJECT_NAME="ProjectPulse AI"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true

# Database (Default: local SQLite; Compatible with PostgreSQL: postgresql://user:password@localhost:5432/projectpulse)
DATABASE_URL="sqlite:///./projectpulse.db"

# Server Host & Port
HOST="0.0.0.0"
PORT=8000

# CORS Origins (comma-separated list of allowed origins)
CORS_ORIGINS="http://localhost,http://localhost:3000,http://localhost:5173,http://localhost:5500,http://localhost:8000,http://127.0.0.1,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:5500,http://127.0.0.1:8000"
